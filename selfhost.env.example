DB_NAME=qari
# For a standalone VPS, point this at the local or managed MongoDB instance.
MONGO_URL=mongodb://localhost:27017
# Same-origin deployment needs no CORS origin. For a separate HTTPS frontend, list exact origins:
# CORS_ORIGINS=https://reader.example.com
CORS_ORIGINS=
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
MAX_UPLOAD_MB=50
MAX_PAGES=2000
MAX_PAGE_PIXELS=50000000
COOKIE_SECURE=true
DISABLE_API_DOCS=true
